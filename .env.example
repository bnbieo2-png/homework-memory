# Copy this file to .env. Never commit the real .env file.

# Required when the page is reachable by another device.
HOMEWORK_NOTEBOOK_USERNAME=student
HOMEWORK_NOTEBOOK_ACCESS_CODE=replace-with-a-long-random-value
HOMEWORK_NOTEBOOK_SESSION_SECRET=replace-with-a-different-long-random-value
HOMEWORK_NOTEBOOK_PORT=18765

# Optional email delivery. Leave all values empty to keep email disabled.
HOMEWORK_NOTEBOOK_EMAIL_RECIPIENT=
HOMEWORK_NOTEBOOK_SMTP_HOST=
HOMEWORK_NOTEBOOK_SMTP_PORT=465
HOMEWORK_NOTEBOOK_SMTP_USER=
HOMEWORK_NOTEBOOK_SMTP_PASSWORD=
HOMEWORK_NOTEBOOK_MAIL_FROM=

# Optional AI-generated learning packs. Disabled unless explicitly set to 1.
# Enabling this may send question text and learning records to your configured AI provider.
HOMEWORK_NOTEBOOK_ENABLE_AI=0
HOMEWORK_NOTEBOOK_OPENCLAW_BIN=openclaw
HOMEWORK_NOTEBOOK_OPENCLAW_AGENT=main
HOMEWORK_NOTEBOOK_OPENCLAW_MODEL=
HOMEWORK_NOTEBOOK_OPENCLAW_THINKING=
